{
  "riscv-ai-adapter": {
    "actual_command": [
      "/usr/bin/python3",
      "-m",
      "riscv_ai_adapter",
      "--config",
      "@HOME@/.config/riscv-ai-adapter/config.toml"
    ]
  },
  "kylinbot": {
    "actual_command": [
      "/usr/local/bin/kylinbot",
      "daemon"
    ]
  },
  "kylinbot-asr-sensevoice": {
    "actual_command": [
      "/usr/bin/python3",
      "@HOME@/.local/share/kylinbot-asr/bin/sensevoice_server.py"
    ]
  },
  "kylinbot-tts": {
    "actual_command": [
      "/usr/bin/python3",
      "@HOME@/riscv-ai-adapter/scripts/tts_server.py",
      "--model-dir",
      "@HOME@/.local/share/riscv-ai-adapter/tts-matcha-20261016/models/tts/matcha-tts",
      "--model-file",
      "matcha-icefall-zh-en/model-steps-3.q.onnx",
      "--profile",
      "matcha-zh-en",
      "--native-bridge",
      "@HOME@/.local/lib/riscv-ai-adapter/tts-matcha-20261016/libkylinbot-matcha.so",
      "--threads",
      "4"
    ]
  },
  "riscv-ai-reader": {
    "actual_command": [
      "/usr/bin/python3",
      "-u",
      "-B",
      "@HOME@/riscv-ai-adapter/tools/reading/reader.py",
      "--file",
      "@HOME@/scenario5-20261028/openKylin-2026.pptx",
      "--title",
      "openKylin社区介绍2026",
      "--start-page",
      "13"
    ]
  },
  "ukui-air-gesture": {
    "actual_command": [
      "/usr/local/bin/ukui-air-gesture"
    ]
  },
  "kylinbot-kws-policy": {
    "actual_command": [
      "/usr/bin/python3",
      "@HOME@/.local/lib/kylinbot/kws-policy.py",
      "--state",
      "/run/user/1000/kylinbot-kws-policy/state"
    ]
  }
}