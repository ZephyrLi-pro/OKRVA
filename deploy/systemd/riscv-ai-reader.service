[Unit]
Description=LibreOffice Impress voice and gesture UNO bridge
Wants=kylinbot.service
After=kylinbot.service

[Service]
Type=notify
NotifyAccess=main
Environment="XDG_RUNTIME_DIR=%t"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus"
Environment="WAYLAND_DISPLAY=wayland-0"
Environment="DISPLAY=:0"
Environment="RVAI_LIBREOFFICE_LAUNCHER=%h/.local/bin/libreoffice-24.8"
Environment="RVAI_IMPRESS_PIPE=rvai_trial_248_1000"
ExecStart=/usr/bin/python3 -u -B %h/riscv-ai-adapter/tools/reading/reader.py
ExecStopPost=-/usr/bin/python3 -B %h/riscv-ai-adapter/tools/reading/reader.py --clear-context
TimeoutStartSec=300
TimeoutStopSec=15
# LibreOffice is the user application; stopping its UNO bridge must not kill it.
KillMode=process
Restart=no
NoNewPrivileges=true
