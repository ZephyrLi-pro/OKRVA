[Unit]
Description=KylinBot daemon
After=network.target kylinbot-asr-sensevoice.service pipewire.service wireplumber.service riscv-ai-adapter.service kylinbot-kws-policy.service
Requires=kylinbot-asr-sensevoice.service riscv-ai-adapter.service
Wants=kylinbot-kws-policy.service

[Service]
Type=simple
ExecStart=/usr/local/bin/kylinbot daemon
Restart=always
RestartSec=3
Environment="HOME=%h"
Environment="KYLINBOT_VAD_BINARY=%h/.local/lib/kylinbot/kylinbot-vad-stream"
Environment="KYLINBOT_VAD_MODEL=%h/.cache/models/asr/sensevoice/silero_vad.onnx"
Environment="PATH=%h/.local/lib/kylinbot:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="KYLINBOT_KWS_BINARY=%h/.local/share/kylinbot-asr/sherpa-v1.13.2/bin/sherpa-onnx-keyword-spotter"
Environment="KYLINBOT_KWS_STREAM_BINARY=%h/.local/lib/kylinbot/kylinbot-kws-gated"
Environment="KYLINBOT_KWS_ENCODER=%h/.cache/models/kws/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/encoder-epoch-12-avg-2-chunk-16-left-64.int8.onnx"
Environment="KYLINBOT_KWS_DECODER=%h/.cache/models/kws/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/decoder-epoch-12-avg-2-chunk-16-left-64.int8.onnx"
Environment="KYLINBOT_KWS_JOINER=%h/.cache/models/kws/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/joiner-epoch-12-avg-2-chunk-16-left-64.int8.onnx"
Environment="KYLINBOT_KWS_TOKENS=%h/.cache/models/kws/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01/tokens.txt"
Environment="KYLINBOT_KWS_KEYWORDS=%h/.cache/models/kws/keywords-nihao-kylin.txt"
Environment="KYLINBOT_KWS_PROVIDER=cpu"
Environment="KYLINBOT_KWS_THREADS=1"
Environment="KYLINBOT_KWS_SCORE=1.0"
Environment="KYLINBOT_KWS_THRESHOLD=0.25"
Environment="KYLINBOT_WAKE_ACK_FILE=%h/.local/share/kylinbot/wake_ack_zh_fast.wav"
Environment="KYLINBOT_KWS_CPUSET=0-3"
Environment="KYLINBOT_KWS_VAD_GATE=1"
Environment="KYLINBOT_KWS_BUSY_FILE=%t/kylinbot-kws-policy/state"
PassEnvironment=DISPLAY XDG_RUNTIME_DIR

[Install]
WantedBy=default.target
