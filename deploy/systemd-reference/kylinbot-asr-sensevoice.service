# %h/.config/systemd/user/kylinbot-asr-sensevoice.service
[Unit]
Description=KylinBot SenseVoice ASR service (SpacemiT EP)
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/.config/kylinbot-asr/env
Environment=SENSEVOICE_MODEL_DIR=%h/.cache/models/asr/sensevoice
Environment=SENSEVOICE_PROVIDER=spacemit
Environment=SENSEVOICE_LANGUAGE=zh
Environment=SENSEVOICE_THREADS=2
Environment=SENSEVOICE_WARMUP_SECONDS=0.5
Environment=SENSEVOICE_PORT=18081
Environment=SPACEMIT_EP_INTRA_THREAD_NUM=2
ExecStart=/usr/bin/env PYTHONPATH=%h/src/model-zoo-asr/build-k1/python LD_LIBRARY_PATH=/usr/lib/riscv64-linux-gnu:/usr/lib /usr/bin/python3 %h/.local/share/kylinbot-asr/bin/sensevoice_server.py
ExecStartPost=/usr/bin/curl --silent --show-error --fail --retry 60 --retry-delay 1 --retry-all-errors http://127.0.0.1:18081/health
Restart=on-failure
RestartSec=3
TimeoutStartSec=90

[Install]
WantedBy=default.target
