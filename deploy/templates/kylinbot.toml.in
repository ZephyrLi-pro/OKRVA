bearer_token = "REPLACE_WITH_YOUR_OWN_VALUE"
max_audio_bytes = 26214400
timeout_secs = 300

[channels]
ack_reactions = true
cli = true
debounce_ms = 0
message_timeout_secs = 300
session_backend = "sqlite"
session_persistence = true
session_ttl_hours = 0
show_tool_calls = false

[channels.voice_wake]
wake_word = "你好麒麟"
silence_timeout_ms = 1500
energy_threshold = 0.008
max_capture_secs = 20

[agent]
compact_context = true
context_aware_tools = false
keep_tool_context_turns = 2
max_context_tokens = 7000
max_history_messages = 16
max_system_prompt_chars = 1500
max_tool_iterations = 10
max_tool_result_chars = 8000
parallel_tools = false
tool_call_dedup_exempt = []
tool_dispatcher = "auto"
tool_filter_groups = []

[agent.context_compression]
enabled = true
identifier_policy = "strict"
max_passes = 3
protect_first_n = 3
protect_last_n = 4
source_max_chars = 50000
summary_max_chars = 4000
threshold_ratio = 0.5
timeout_secs = 60
tool_result_retrim_chars = 2000
tool_result_trim_exempt = []

[agent.eval]
enabled = false
max_retries = 1
min_quality_score = 0.5

[agent.history_pruning]
collapse_tool_results = true
enabled = false
keep_recent = 4
max_tokens = 8192

[agent.thinking]
default_level = "medium"

[agents]

[autonomy]
allowed_roots = ["@HOME@/\u6587\u6863", "@HOME@/Desktop"]
always_ask = []
auto_approve = ["file_read", "memory_recall", "web_search_tool", "web_fetch", "calculator", "glob_search", "content_search", "image_info", "weather", "browser", "browser_open", "ocr", "subject_segmentation", "shell"]
level = "supervised"
max_actions_per_hour = 20
non_cli_excluded_tools = []
shell_env_passthrough = ["XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "DISPLAY", "WAYLAND_DISPLAY"]
shell_timeout_secs = 60
workspace_only = true

[autonomy.security]
approval_enabled = true
credential_scrub_enabled = true
enabled = true
env_clear_enabled = true
estop_enabled = true
leak_detector_enabled = true
path_guard_enabled = true
rate_limit_enabled = true

[autonomy.security.gates]
background = true
block_high_risk = true
dangerous_commands = true
readonly = true
redirect = true
require_approval_for_medium = true
subshell = true
whitelist = true

[autonomy.security.rules]

[autonomy.security.rules.background]
block_commands = ["tee"]

[autonomy.security.rules.dangerous_commands]
high_risk_commands = ["rm", "mkfs", "dd", "shutdown", "reboot", "halt", "poweroff", "sudo", "su", "chown", "chmod", "useradd", "userdel", "usermod", "passwd", "mount", "umount", "iptables", "ufw", "firewall-cmd", "curl", "wget", "nc", "ncat", "netcat", "scp", "ssh", "ftp", "telnet"]
high_risk_substring_patterns = ["rm -rf /", "rm -fr /", ":(){:|:&};:", "del /s /q", "rmdir /s /q", "format c:"]

[autonomy.security.rules.dangerous_commands.medium_risk_commands]
cargo = ["add", "remove", "install", "clean", "publish"]
copy = "always"
cp = "always"
git = ["commit", "push", "reset", "clean", "rebase", "merge", "cherry-pick", "revert", "branch", "checkout", "switch", "tag"]
ln = "always"
mkdir = "always"
mklink = "always"
move = "always"
mv = "always"
npm = ["install", "add", "remove", "uninstall", "update", "publish"]
pnpm = ["install", "add", "remove", "uninstall", "update", "publish"]
ren = "always"
rename = "always"
robocopy = "always"
touch = "always"
xcopy = "always"
yarn = ["install", "add", "remove", "uninstall", "update", "publish"]

[autonomy.security.rules.environment]
safe_env_vars = ["PATH", "HOME", "TERM", "LANG", "LC_ALL", "LC_CTYPE", "USER", "SHELL", "TMPDIR"]

[autonomy.security.rules.redirect]
patterns = [">", "<"]
safe_input_targets = ["null", "zero"]
safe_output_targets = ["null", "zero", "stdout", "stderr"]

[autonomy.security.rules.subshell]
patterns = ["`", "$(", "<(", "("]

[autonomy.security.rules.whitelist]
allowed_commands = ["git", "npm", "cargo", "ls", "cat", "grep", "find", "echo", "pwd", "wc", "head", "tail", "date", "df", "du", "uname", "uptime", "hostname", "python", "python3", "pip", "node", "free", "wpctl", "pcmanfm-qt", "lxqt-config", "xdg-open"]
dangerous_args = [{ command = "find", deny_arg_prefixes = [], deny_args = ["-exec", "-ok"] }, { command = "git", deny_arg_prefixes = ["config.", "alias."], deny_args = ["config", "alias", "-c"] }, { command = "python", deny_arg_prefixes = ["-c", "-m"], deny_args = [] }, { command = "python3", deny_arg_prefixes = ["-c", "-m"], deny_args = [] }, { command = "node", deny_arg_prefixes = ["-e", "--eval", "-p", "--print"], deny_args = [] }, { command = "pip", deny_arg_prefixes = [], deny_args = ["install", "download"] }, { command = "pip3", deny_arg_prefixes = [], deny_args = ["install", "download"] }, { command = "npm", deny_arg_prefixes = [], deny_args = ["exec", "install", "i", "add", "ci"] }, { command = "cargo", deny_arg_prefixes = [], deny_args = ["install"] }]
forbidden_paths = ["/etc", "/root", "/home", "/usr", "/bin", "/sbin", "/lib", "/opt", "/boot", "/dev", "/proc", "/sys", "/var", "/tmp", "~/.ssh", "~/.gnupg", "~/.aws", "~/.config"]

[backup]
