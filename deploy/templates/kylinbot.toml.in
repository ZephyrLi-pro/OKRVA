model = "qwen2.5:7b"
timeout_secs = 120

[transcription]
enabled = true
default_provider = "local_whisper"
language = "zh"
max_duration_secs = 60
api_url = "https://api.groq.com/openai/v1/audio/transcriptions"
model = "whisper-large-v3-turbo"
