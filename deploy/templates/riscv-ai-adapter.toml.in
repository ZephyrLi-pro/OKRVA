[server]
host = "127.0.0.1"
port = 18080
request_limit_bytes = 33554432
token_env = ""
allow_remote = false

# The competition path is sequential (ASR -> KylinBot -> LLM), so one request
# per inference class keeps memory usage and latency predictable on K1.
[resource_groups]
heavy_inference = 1
speech_pipeline = 1

[[backends]]
document_tasks = true
semantic_system_planner = true
grounded_system_planner = true
reading_summary_backend = "k1-reading-summary"
name = "k1-qwen3-llama"
exclusive_with = ["k1-reading-summary"]
capability = "chat"
enabled = true
required = true
url = "http://127.0.0.1:18082/v1/chat/completions"
health_url = "http://127.0.0.1:18082/health"
models = ["qwen-local"]
upstream_model = "Qwen3-0.6B-Q4_K_M.gguf"
# Keep the local task tool surface bounded, avoiding KylinBot's
# full ~12k-token tool catalog on every request.
allowed_tools = ["shell", "file_read", "file_write", "glob_search", "sys__set_volume", "sys__get_volume", "sys__get_capabilities", "sys__adjust_volume", "sys__set_mute", "sys__wifi_status", "sys__wifi_scan", "sys__bluetooth_status", "sys__get_brightness", "sys__open_application", "docs__recent_documents", "docs__read_document", "docs__save_report", "docs__list_reports", "docs__trash_reports", "ppt__open_presentation", "ppt__get_current_slide", "ppt__save_speaker_notes"]
# KylinBot 0.7.4's Gateway Agent path can bypass its own prompt-size setting.
# Enforce the K1 budget again at the model boundary.
max_system_prompt_chars = 1500
system_prompt_override = """你是 KylinBot 在 Bianbu LXQt RISC-V 电脑上的本地系统助手。严格执行用户的当前请求。凡是执行系统操作、查询真实系统状态或读写查找文件，必须调用提供的函数工具，绝对不能猜测或伪造工具结果。shell 用于安全的系统命令，file_read 用于读取已知文件，file_write 用于保存结果，glob_search 用于查找文件。收到工具结果后，用用户的语言简短回答。回答路径、数值或文件名时必须逐字复制工具输出，不得改写、省略或猜测。除非用户明确要求，不要生成示例任务或待办事项。绝对音量用sys__set_volume，查询音量用sys__get_volume，按百分点增减用sys__adjust_volume。静音用sys__set_mute，取消静音muted=false。打开文件管理器或系统设置用sys__open_application，application分别为file_manager或system_settings，不用shell代替。网络、蓝牙、亮度查询用对应sys工具。不可用操作先查sys__get_capabilities，不能声称已执行。多步骤任务必须逐项完成并确认真实结果，不能省略后续步骤。只根据工具content内text简短回答，不输出JSON；只有实际回读或窗口验证成功才能说操作成功。"""
timeout_seconds = 600
health_timeout_seconds = 3
max_concurrency = 1
acquire_timeout_seconds = 10
priority = 50
resource_group = "heavy_inference"
managed = true
environment = { SPACEMIT_Q4K_CPU_DECODE = "1", SPACEMIT_DISABLE_TCM = "0", SPACEMIT_K1_TCM_SPLIT = "1" }
command = [
  "${HOME}/.local/lib/riscv-ai-adapter/llama-q6-rvv-20261030/llama-server-tcm",
  "-m", "${HOME}/.cache/models/llm/spacemit-20261010/Qwen3-0.6B-Q4_K_M.gguf",
  "-t", "4",
  "--host", "127.0.0.1",
  "--port", "18082",
  "--ctx-size", "4096",
  "--n-gpu-layers", "0",
  "--batch-size", "512",
  "--parallel", "1",
  "--metrics",
  "--cache-ram", "0",
  "--no-mmap",
  "--no-warmup",
  "--repack",
  "--jinja",
  "--reasoning", "off",
]
restart_on_failure = true
restart_backoff_seconds = 3
max_restarts = 5

[[backends]]
name = "k1-sensevoice-spacemit"
capability = "transcription"
enabled = true
required = true
url = "http://127.0.0.1:18081/v1/audio/transcriptions"
health_url = "http://127.0.0.1:18081/health"
models = ["sensevoice-small", "paraformer-zh-small"]
api_key_env = "KYLINBOT_ASR_TOKEN"
timeout_seconds = 300
health_timeout_seconds = 3
max_concurrency = 1
acquire_timeout_seconds = 10
priority = 90
resource_group = "speech_pipeline"

# Local Chinese VITS worker, deployed on loopback port 18083.
[[backends]]
name = "k1-sherpa-tts"
capability = "speech"
enabled = true
required = false
url = "http://127.0.0.1:18083/v1/audio/speech"
health_url = "http://127.0.0.1:18083/health"
models = ["vits-zh"]
timeout_seconds = 300
max_concurrency = 1
priority = 70
resource_group = "speech_pipeline"

# OCR/VLM are deliberately outside the first milestone. Native document text
# and current-page context go directly to KylinBot; image OCR can be added here.
[[backends]]
name = "k1-onnx-ocr"
capability = "ocr"
enabled = false
required = false
url = "http://127.0.0.1:18084/v1/ocr"
health_url = "http://127.0.0.1:18084/health"
models = ["ppocr-mobile"]
timeout_seconds = 120
max_concurrency = 1
priority = 20
resource_group = "heavy_inference"



[[backends]]
name = "k1-reading-summary"
exclusive_with = ["k1-qwen3-llama"]
capability = "chat"
enabled = true
required = false
on_demand = true
idle_timeout_seconds = 60
url = "http://127.0.0.1:18084/v1/chat/completions"
health_url = "http://127.0.0.1:18084/health"
models = ["reading-summary"]
upstream_model = "Qwen3-1.7B-Q4_0.gguf"
allowed_tools = []
timeout_seconds = 600
health_timeout_seconds = 2
max_concurrency = 1
acquire_timeout_seconds = 60
priority = 50
resource_group = "heavy_inference"
managed = true
restart_on_failure = false
environment = { PYTHONPATH = "@HOME@/riscv-ai-adapter/src", LD_LIBRARY_PATH = "@HOME@/.local/lib/riscv-ai-adapter/llama-q6-rvv-20261030/lib", SPACEMIT_Q4K_CPU_DECODE = "1", SPACEMIT_DISABLE_TCM = "1", SPACEMIT_K1_TCM_SPLIT = "0", SPACEMIT_PERFER_CORE_ID = "0,1,2,3", SPACEMIT_PERFER_CORE_ARCH = "a03c", OMP_PROC_BIND = "TRUE", GOMP_CPU_AFFINITY = "0 1 2 3" }
command = [
  "/usr/bin/python3", "-B", "-m", "riscv_ai_adapter.model_worker",
  "--startup-min-mib", "2048", "--runtime-min-mib", "512", "--",
  "/usr/bin/llama-server", "-m", "@HOME@/.cache/models/llm/reading-20261102/Qwen3-1.7B-Q4_0.gguf",
  "-t", "3", "--threads-batch", "4", "--host", "127.0.0.1", "--port", "18084",
  "--ctx-size", "3072", "--batch-size", "128", "--ubatch-size", "128",
  "--parallel", "1", "--n-gpu-layers", "0", "--no-warmup", "--repack", "--jinja",
  "--reasoning", "off", "--cache-ram", "0"
]
