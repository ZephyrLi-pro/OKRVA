+// Opt-in K1/v1 coexistence mode: ASR retains two of four 128-KiB blocks.
+// Give each of the four LLM workers its own non-overlapping 64-KiB slice.
+// v1 has process-lifetime mappings and no per-core acquire/release protocol;
+// never share a v2 lease between workers through this legacy-only path.
+struct k1_tcm_workspace_pool {
+    static constexpr size_t slice_bytes = 64 * 1024;
+    std::array<void *, 4> slices{};
+    std::array<int, 4> blocks{};
+    int acquired = 0;
+    bool enabled = false;
+
+    k1_tcm_workspace_pool() {
+        const char * value = std::getenv("SPACEMIT_K1_TCM_SPLIT");
+        enabled = value && std::strcmp(value, "1") == 0;
+        if (!enabled) {
+            return;
+        }
+        if (!global_spine_env_info.use_tcm || !global_spine_env_info.use_ime1 ||
+            global_spine_env_info.perfer_core_arch_id != spine_core_arch_id::core_arch_a60 ||
+            global_spine_env_info.perfer_core_ids.size() != slices.size() ||
+            global_spine_env_info.tcm_blk_size != 2 * slice_bytes) {
+            GGML_ABORT("K1 TCM split requires four K1 AI cores and 128-KiB TCM blocks");
+        }
+        if (spine_tcm_open_handle(nullptr) != 0) {
+            GGML_ABORT("K1 TCM split cannot load the TCM runtime");
+        }
+        spine_tcm_mem_info_t layout{};
+        if (spine_tcm_mem_info(&layout) != 0 || layout.is_fake_tcm) {
+            GGML_ABORT("K1 TCM split requires real TCM, not emulated buffers");
+        }
+        spine_tcm_block_info_t metadata{};
+        if (spine_tcm_block_info(0, &metadata) != 0 || metadata.is_acquired != -1 ||
+            metadata.cpu_affinity_mask != 0 || metadata.phys_addr != 0) {
+            GGML_ABORT("K1 TCM split requires the legacy v1 allocation-only backend");
+        }
+        // Function-static initialization serializes allocation before any
+        // worker receives a view; allocation failure must never mix layouts.
+        for (int block = 0; block < 2; ++block) {
+            auto * base = static_cast<char *>(spine_mem_pool_tcm_mem_get(block));
+            if (!base) {
+                GGML_ABORT("K1 TCM split cannot reserve two blocks; TCM is busy");
+            }
+            ++acquired;
+            for (int part = 0; part < 2; ++part) {
+                slices[block * 2 + part] = base + part * slice_bytes;
+                blocks[block * 2 + part] = block;
+            }
+        }
+        GGML_LOG_INFO("K1 TCM split: 2 x 128 KiB reserved, 4 x 64 KiB worker workspaces\n");
+    }
+
+    ~k1_tcm_workspace_pool() {
+        for (int block = 0; block < acquired; ++block) {
+            spine_tcm_mem_free(block);
+        }
+    }
+};
