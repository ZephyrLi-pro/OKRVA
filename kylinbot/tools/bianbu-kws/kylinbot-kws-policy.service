[Unit]
Description=KylinBot low-cost wake policy (fail-open)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/lib/kylinbot/kws-policy.py --state %t/kylinbot-kws-policy/state
RuntimeDirectory=kylinbot-kws-policy
RuntimeDirectoryMode=0700
CPUAffinity=4 5 6 7
Restart=on-failure
RestartSec=3
TimeoutStopSec=3

[Install]
WantedBy=default.target
